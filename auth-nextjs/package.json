{
  "name": "@pylo/auth-nextjs",
  "version": "0.1.4",
  "description": "Next.js authentication utilities for Pylo",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts --dts --format esm --out-dir dist --no-splitting --clean",
    "watch": "tsc -w",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "keywords": [
    "pylo",
    "auth",
    "authentication",
    "nextjs"
  ],
  "author": "Okeano GmbH",
  "license": "MIT",
  "homepage": "https://github.com/Okeano-GmbH/pylo-sdks/tree/main/auth-nextjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Okeano-GmbH/pylo-sdks.git",
    "directory": "auth-nextjs"
  },
  "bugs": {
    "url": "https://github.com/Okeano-GmbH/pylo-sdks/issues"
  },
  "packageManager": "pnpm@10.12.1",
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "dependencies": {
    "@pylo/auth": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "next": "^16.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
