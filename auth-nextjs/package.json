{
  "name": "@pylo/auth-nextjs",
  "version": "0.0.2",
  "description": "Next.js authentication utilities for Pylo",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts --dts --format esm --out-dir dist",
    "watch": "tsc -w"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "pylo",
    "auth",
    "authentication",
    "nextjs"
  ],
  "license": "ISC",
  "packageManager": "pnpm@10.12.1",
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "dependencies": {
    "@pylo/auth": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "next": "^16.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
