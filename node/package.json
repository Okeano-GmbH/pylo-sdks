{
  "name": "@pylo/node",
  "version": "0.0.4",
  "description": "Server-side Pylo SDK with API key authentication",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "pylo": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsc -w",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@pylo/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.12.1"
}
