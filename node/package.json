{
  "name": "@pylo/node",
  "version": "0.4.0",
  "description": "Server-side Pylo SDK with API key authentication",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js",
      "default": "./dist/codegen.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "pylo": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsc -w",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "dependencies": {
    "@pylo/auth": "workspace:*",
    "@pylo/core": "workspace:*",
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "author": "Okeano GmbH",
  "license": "MIT",
  "homepage": "https://github.com/Okeano-GmbH/pylo-sdks/tree/main/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Okeano-GmbH/pylo-sdks.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/Okeano-GmbH/pylo-sdks/issues"
  },
  "packageManager": "pnpm@10.12.1"
}
