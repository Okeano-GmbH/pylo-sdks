    "url": "git+https://github.com/Okeano-GmbH/pylo-sdks.git",
    "directory": "auth"
  },
  "bugs": {
    "url": "https://github.com/Okeano-GmbH/pylo-sdks/issues"
  },
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
